# Normalize line endings: LF in the repo, native on checkout
* text=auto eol=lf

# Source and project files
*.cs        text diff=csharp
*.csproj    text
*.props     text
*.targets   text
*.slnx      text
*.sln       text eol=crlf
*.md        text diff=markdown
*.json      text
*.yml       text
*.yaml      text
*.xml       text

# Binaries
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.dll  binary
*.exe  binary
